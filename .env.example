# Copy to `.env.local` and fill in. `.env*` is gitignored except this file.
# Never commit real credentials, and never point a local or preview build at
# the production cluster — see docs/APP-PLAN.md §4.5.

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Atlas SRV string, no database name in the path — the database is set
# separately so the same cluster can host dev/preview databases.
#
# The password must be percent-encoded if it contains @ : / ? # [ ] % or a
# space. Atlas copies it in raw, which silently produces an unparseable URI.
#
# The cluster address is a placeholder on purpose. This repository is
# public, and the Atlas IP access list is currently 0.0.0.0/0 — with the
# network layer open, the database password is the only control, so there
# is no reason to publish the hostname it protects as well.
MONGODB_URI="mongodb+srv://USERNAME:PASSWORD@CLUSTER.EXAMPLE.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0"

# Database name. Kept out of the URI on purpose (see above).
MONGODB_DB="nikahcanada"
